
<% layout("./layouts/boilerplate") %>
<body>
  <script>
     let maptoken = "<%=process.env.MAP_TOKEN%>";
      let listing = <%- JSON.stringify(list) %>;
  </script>


<div class="row mt-4">
    <div class="col-8 offset-3 show-title">
 <i><h3><%=list.title%></h3></i>
 </div>

<div class="card col-6 offset-3 mt-1 show-card" >
  <img src="<%=list.image.url%>" class="card-img-top show-img" alt="listimage">
  <div class="card-body">
    <p class="card-text">
       <i><p>own by @<%=list.owner.username%> </p></i>
       <p> description: <%=list.description%></p>
       <p> price: &#8377;<%=list.price.toLocaleString("en-IN")%> </p>
       <p>location: <%=list.location%></p>
       <p>country: <%=list.country%></p>
      
    </p>
  </div>
</div>

</div>

 <% if( user && list.owner.equals(user._id)){%>
    <div class="btns mb-5">

<a href="/listings/<%=list._id%>/update" class="btn btn-info col-1 offset-3">edit</a>

<form method="post" action="/listings/<%=list._id%>?_method=delete">
    <button class="btn btn-danger  offset-4">delete</button>
</form>
</div>


 <% }%>
 <hr>
   

<%if(user){%>

<div  class="row mt-3">
<form class="needs-validation" method="post" action="/listings/<%=list._id%>/review" novalidate>
  <div class="col-6 offset-3">
    <h4 class="mt-2">leav review</h4>
  
<fieldset class="starability-slot mt-4 star">
 
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]"  value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>


<div mb-3>
<label for="comment" class="form-label">comment:</label>
<textarea name="review[comment]" id="comment" placeholder="write massage" class="form-control" rows="5"cols="10" required></textarea>
<div class="invalid-feedback">please write comment</div>
</div>
<button class="btn-outline theme-inverse mb-3 mt-3">submit</button>
</div>
</form>
</div>

<hr>
<%}%>


<%if(list.review.length > 0){%>
  
<div class="row col-6 offset-3">
 <i><h3> all reviews</h3></i>
</div>

<div class="row review-cd col-8 offset-3">
 <%for( reviews of list.review){%>
  <div class="card card-w col-5" >
    <div class="card-body review-card">
       <h5  class="ps-4 pe-2 card-owner">  posted by: @<%=reviews.auther.username%></h5>
         <p class="starability-result star ms-3" data-rating="<%=reviews.rating%>"></p>

      <p  class="ps-4 pe-2"> <b>comment</b> :<%=reviews.comment%></p>
   
         <%if(user && reviews.auther.equals(user._id)){%>
              <form method="post" action="/listings/<%=list._id%>/review/<%=reviews._id%>?_method=delete">
      <button class="btn btn-dark ms-3 mb-2">delete</button>
    </form>
        <% }%>
    

      </div>
    
    </div>  
 <%}%>
 </div>

<%}%>

<div class="row maps col-7 offset-3" >
<h3 class="map-heading">where you'll be</h3>
<div id="map"></div>

</div>


<script src="/js/map.js"></script>
</body>
