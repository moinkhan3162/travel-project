<% layout("./layouts/boilerplate") %>

<body>
    <div class="filters-box">


    <button class="scroll-btn" id="leftBtn">
        &#10094;
    </button>
      <div class="filters" id="filters">

     <a href="/listings?category=trendings">
       <div class="filter">
        <div class="filter-icon">
        <i class="fa-solid fa-fire"></i>
        </div>
         trendings
      </div>
     </a>

      <a href="/listings?category=mountains">
       <div class="filter">
        <div class="filter-icon">
        <i class="fa-solid fa-mountain-sun"></i>
        </div>
         mountains
      </div>
     </a>

     
      <a href="/listings?category=cube">
       <div class="filter">
        <div class="filter-icon">
        <i class="fa-solid fa-igloo"></i>
        </div>
         igloo
      </div>
     </a>

       <a href="/listings?category=prime cities">
       <div class="filter">
        <div class="filter-icon">
       <i class="fa-solid fa-mountain-city"></i>
        </div>
         prime cities
      </div>
     </a>
      
     
       <a href="/listings?category=sea view">
       <div class="filter">
        <div class="filter-icon">
       <i class="fa-solid fa-person-swimming"></i>
        </div>
         sea view
      </div>
     </a> 
     
       <a href="/listings?category=boating">
       <div class="filter">
        <div class="filter-icon">
       <i class="fa-solid fa-ship"></i>
        </div>
          boating
      </div>
     </a>
     
       <a href="/listings?category=3 star hotels">
       <div class="filter">
        <div class="filter-icon">
      <i class="fa-solid fa-hotel"></i>
        </div>
         3 star hotels
      </div>
     </a>   
     
       <a href="/listings?category=luxary hotels">
       <div class="filter">
        <div class="filter-icon">
       <i class="fa-solid fa-hotel"></i>
        </div>
         luxary hotels
      </div>
     </a>   
     
       <a href="/listings?category=snow cities">
       <div class="filter">
        <div class="filter-icon">
       <i class="fa-solid fa-snowflake"></i>
        </div>
         snow cities
      </div>
     </a> 
    </div>
     <button class="scroll-btn" id="rightBtn">
        &#10095;
    </button>

     <div class="tax-field">
     <div class="form-check form-switch tax-switch ">
  <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
  <label class="form-check-label" for="flexSwitchCheckDefault">totall after taxes</label>
      </div>
      </div>
</div>

    
   
   

   <div class="row row-cols-lg-4 row-cols-md-3 row-cols-xs-2">
  <% for( let list of lists){%>
    <a href="/listings/<%=list._id%>" class="card-a">
    <div class="card col">

  <img src="<%=list.image.url%>" class="card-img-top all-img" alt="image" style="height: 20rem;">
  <div class="card-body">
    <p class="card-text"> 
      <b><%=list.title%> </b> <br>
     &#8377;<%=list.price.toLocaleString("en-IN")%>/ night
     <i class="tax-info"> &nbsp;  +18% GST</i>
    </p>
   
  </div>
</div>
</a>
    
  

<%}%>
</div>


<script src="/js/taxswitch.js" defer></script>

</body>
 


