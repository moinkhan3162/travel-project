<% layout("./layouts/boilerplate") %>
<body>
    
   <div class="row col-8 offset-2 con">
     <form novalidate class="needs-validation" method="post" action="/listings/<%=list._id%>?_method=put" enctype="multipart/form-data">
   <div class="mb-3 mt-3 ">
            <label for="title" class="form-label">titel:</label>
            <input name="listing[title]"  type="text" value="<%=list.title%>" id="title" class="form-control" required>
             <div class="invalid-feedback"> please enter title</div>
        </div>
        
         <div class="mb-3">
            <label for="description" class="form-label">description:</label>
            <textarea name="listing[description]"  cols="80" rows="3" id="description" class="form-control" required><%=list.description%></textarea>
             <div class="invalid-feedback"> please write description</div>
        </div>

        <div class="mb-3">
            <p>current image</p>
            <img src="<%=orignalurl%>" alt="hotel image">
        </div>
        
        <div class="mb-3">
            <label for="image" class="form-label">image:</label>
            <input name="listing[image]"  type="file"  id="image" class="form-control" >
        </div>
        
        <div class="row ">
        <div class="mb-3 col-4 full">
            <label for="price" class="form-label">price:</label>
        <input name="listing[price]"  type="number" value="<%=list.price%>" id="price" class="form-control" required>
         <div class="invalid-feedback"> please enter valide price</div>
        </div>
        
        <div class="mb-3 col-7 full">
            <label for="location" class="form-label">location:</label>
          <input name="listing[location]"  type="text" value="<%=list.location%>" id="location" class="form-control" required>
                  <div class="invalid-feedback"> please enter your location</div>
        </div>
        </div>
        
        <div class="mb-3">
            <label for="country" class="form-label">country:</label>
             <input name="listing[country]" type="text" value="<%=list.country%>" id="country" class="form-control" required>
             <div class="invalid-feedback">please enter your country</div>
        </div>
        <br>
    <button class="btn btn-info mb-5">submit</button>
    
    </form>
    
    </div>

    
</body>


 
    