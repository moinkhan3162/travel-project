
<body>
  <% if(success.length){%>
<div class="alert alert-success  col-6 offset-3 mt-2  position-relative" role="alert">
   <p class="mb-0"><%= success %></p> 
   <button type="button" class="btn-close  ms-auto position-absolute top-0 end-0 mt-3 me-2 mb-3" data-bs-dismiss="alert" aria-label="Close"></button>
    
</div>
<%}%>

 <% if(err.length){%>
  <div class="alert alert-danger  col-6 offset-3 mt-2 position-relative" role="alert">
  <p class="mb-0"><%=err%></p>
  <button type="button" class="btn-close ms-auto position-absolute top-0 end-0 mt-3 me-2 mb-3" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

   <%}%>


</body>
